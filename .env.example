# Supabase cloud sync. Create a project at https://supabase.com, run
# supabase/schema.sql in the SQL editor, then copy this file to .env and fill
# it in. The app still runs fully offline if these are empty.
#
# EXPO_PUBLIC_* is inlined into the app bundle — public by definition. Only
# the publishable (anon) key belongs here; RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — the direct Postgres connection used to apply
# supabase/schema.sql from a terminal. Never prefix this with EXPO_PUBLIC_
# and never reference it from src/, or the app would ship DB credentials.
SUPABASE_DB_URL=
