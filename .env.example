# Supabase cloud sync. Create a project at https://supabase.com, run
# supabase/schema.sql in the SQL editor, then copy this file to .env and fill
# it in. The app still runs fully offline if these are empty.
#
# EXPO_PUBLIC_* is inlined into the app bundle — public by definition. Only
# the publishable (anon) key belongs here; RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — the Postgres connection used to apply supabase/*.sql
# from a terminal. Never prefix this with EXPO_PUBLIC_ and never reference it
# from src/, or the app would ship DB credentials.
#
# Use the SESSION POOLER string from the dashboard (Project Settings →
# Database → Connection string → Session pooler), NOT the "Direct connection"
# one: db.<ref>.supabase.co is IPv6-ONLY, so on an IPv4-only machine it fails
# with "Network is unreachable" before it can authenticate. Port 5432 is
# session mode and supports DDL; 6543 is transaction mode and does not.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
